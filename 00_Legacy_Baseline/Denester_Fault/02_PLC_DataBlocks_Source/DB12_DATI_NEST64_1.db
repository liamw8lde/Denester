DATA_BLOCK "DATI_NEST64_1" // DB12 — EN: 64-nest recipe data (1 clamp) / DE: Rezeptdaten 64er Nest
VERSION : 0.1
VAR_INPUT
  ActualPos : DINT ;	//posizione encoder
END_VAR
VAR_OUTPUT
  NextPos : INT ;	//posizione successiva
END_VAR
VAR_IN_OUT
  NrPos : INT  := 1;	//numero posizione
  CmdMove : BOOL ;	//comando movimento
  PosReserced : BOOL ;	//posizione puntata raggiunta
END_VAR
VAR
  FineTabella : INT ;	//indice di fine tabella 
  P1 : INT ;	//passo nest
  P2 : INT ;	
  P3 : INT ;	
  P4 : INT ;	
  P5 : INT ;	
  P6 : INT ;	
  P7 : INT ;	
  P8 : INT ;	
  P9 : INT ;	
  P10 : INT ;	
  P11 : INT ;	
  P12 : INT ;	
  P13 : INT ;	
  P14 : INT ;	
  P15 : INT ;	
  P16 : INT ;	
  P17 : INT ;	
  P18 : INT ;	
  P19 : INT ;	
  P20 : INT ;	
  AppRead : BOOL ;	
  Read : BOOL ;	
  AppMove : BOOL ;	
END_VAR
VAR_TEMP
  AdrPunta : DWORD ;
BEGIN
END_DATA_BLOCK
